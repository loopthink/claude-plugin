{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "loopthink-s3",
  "displayName": "Loopthink for S3",
  "version": "0.1.1",
  "description": "Let your whole team ask about the files in your S3 bucket in plain language, without handing out access keys. Confined to one bucket or folder, read-only by default and logged by Loopthink.",
  "author": {
    "name": "Loopthink (TechnologyCircle GmbH)",
    "email": "info@technologycircle.io",
    "url": "https://www.loopthink.ai"
  },
  "homepage": "https://www.loopthink.ai/connect/s3",
  "repository": "https://github.com/loopthink/claude-plugin",
  "license": "MIT",
  "keywords": [
    "s3",
    "amazon-s3",
    "aws",
    "object-storage",
    "bucket",
    "s3-compatible",
    "hetzner",
    "wasabi",
    "cloudflare-r2",
    "files",
    "csv",
    "json",
    "exports",
    "read-only-by-default"
  ]
}
